  m_Script: {fileID: 11500000, guid: c92feac0825f0254a8b1b59e334880d8, type: 3}
  m_Name: IntroDialog 2
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue.DialogueData
  Lines:
  - Text: "La armadura est\xE1 completa. Ahora puedes enfrentarlo. \r\n"
    CharacterPortrait: {fileID: -1887934901, guid: f68619ee4b97e654fb39a790e98c0894, type: 3}
    CharacterName: Diosa
    TypewriterSpeed: 20
  - Text: "Lucha siendo t\xFA mismo."
    CharacterPortrait: {fileID: -1887934901, guid: f68619ee4b97e654fb39a790e98c0894, type: 3}
    CharacterName: Diosa
    TypewriterSpeed: 20
  - Text: "Yo soy el mal que nunca muri\xF3."
    CharacterPortrait: {fileID: 21300000, guid: 09f502b1047044c4282b7dc5595a62cb, type: 3}
    CharacterName: Guerrero
    TypewriterSpeed: 20
  - Text: "Ella solo me durmi\xF3. \r\nT\xFA caer\xE1s."
    CharacterPortrait: {fileID: 21300000, guid: 09f502b1047044c4282b7dc5595a62cb, type: 3}
    CharacterName: Guerrero
    TypewriterSpeed: 20
